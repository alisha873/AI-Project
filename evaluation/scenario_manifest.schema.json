{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoShield Controlled Scenario Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_family",
    "description",
    "environment",
    "execution",
    "ground_truth_reference"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^scenario_[0-9]{3}$"
    },
    "scenario_family": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "const": "isolated_docker_lab"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "target_allowlist"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "manual",
            "scripted"
          ]
        },
        "target_allowlist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ground_truth_reference": {
      "type": "string",
      "minLength": 1
    }
  }
}
