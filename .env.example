APP_ENV=development

LLM_PROVIDER=gemini
LLM_API_KEY=
# Gemini Developer API key (placeholder only; put the real key in your local, git-ignored .env).
# The Gemini client reads GEMINI_API_KEY only. It does not fall back to GROQ_API_KEY or LLM_API_KEY.
GEMINI_API_KEY=
# Gemini model. The hosted stages use this id; do not substitute another model here.
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq key (optional explicit --provider groq only; placeholder). Not used by the Gemini path.
GROQ_API_KEY=
# Optional Groq model override (Groq client default: openai/gpt-oss-20b). Not read by the Gemini client.
# LLM_MODEL=openai/gpt-oss-20b
# Optional completion-token limit sent as max_completion_tokens (whole number, 1 to 32768).
# Leave unset to use the provider's own default. No value is known to fix a given failure.
# LLM_MAX_COMPLETION_TOKENS=
# Per-MINUTE token budget (TPM). Blank = no assumed quota: the Gemini client does not apply Groq's
# recorded 8,000 tokens/minute ceiling. Set a number only for a limit you have verified on the
# configured account, or 0 to disable the guard. The optional Groq client still defaults to 8000
# when this is blank.
# LLM_TPM_LIMIT=
# Optional pre-send PER-REQUEST size budget (whole number). Blank = off (the TPM budget above still applies).
# LLM_TOKEN_BUDGET=
# Optional retry count for one call (0 to 10 extra submissions after the first). Blank = that client's
# own default: Gemini sends the request once; the Groq SDK retries twice. 0 = one submission.
# LLM_MAX_RETRIES=

VECTOR_DB_PATH=./knowledge/vector_store

LOG_LEVEL=INFO

# Phase 13 live-validation opt-in. Leave unset. A genuine authorized live run also needs
# --i-accept-authorized-live-validation, both reviewer approvals, an approved lab, and a
# live-suitable identity. Setting this to 1 is NOT approval and does not send traffic by itself.
# AUTOSHIELD_LIVE_VALIDATION=