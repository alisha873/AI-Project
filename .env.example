APP_ENV=development

LLM_PROVIDER=
LLM_API_KEY=
# Groq key (placeholder only; put the real key in your local, git-ignored .env).
# GROQ_API_KEY is preferred; LLM_API_KEY is accepted as a fallback.
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-20b)
# LLM_MODEL=openai/gpt-oss-20b
# Optional completion-token limit sent as max_completion_tokens (whole number, 1 to 32768).
# Leave unset to use the provider's own default. No value is known to fix a given failure.
# LLM_MAX_COMPLETION_TOKENS=
# Per-MINUTE token budget (TPM), ON by default for Groq. Blank = the built-in default (the recorded
# ~8000 Groq on-demand ceiling; configurable, NOT a universal limit or a model context window). Set a
# number to override for your account/model, or 0 to disable the pre-send per-minute guard entirely.
# LLM_TPM_LIMIT=
# Optional pre-send PER-REQUEST size budget (whole number). Blank = off (the TPM budget above still applies).
# LLM_TOKEN_BUDGET=
# Optional SDK retry count for one call (0 to 10). Blank = the Groq SDK default (2); 0 = one submission.
# LLM_MAX_RETRIES=

VECTOR_DB_PATH=./knowledge/vector_store

LOG_LEVEL=INFO

# Phase 13 live-validation opt-in. Leave unset. A genuine authorized live run also needs
# --i-accept-authorized-live-validation, both reviewer approvals, an approved lab, and a
# live-suitable identity. Setting this to 1 is NOT approval and does not send traffic by itself.
# AUTOSHIELD_LIVE_VALIDATION=