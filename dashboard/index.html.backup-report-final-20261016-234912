  async function updateReport() {
    const report = $("reportView");
    if (!report || report.dataset.realIntegration === "done") return;

    try {
      const artifacts = await loadArtifacts();
      const rag = artifacts["rag_report.json"];
      const bnnResponse = await fetch(API + "/api/bnn-risk");
      if (!bnnResponse.ok) throw new Error("BNN API returned HTTP " + bnnResponse.status);
      const bnnData = await bnnResponse.json();
      const result = bnnData.result || {};
      const bayes = result.bayesian_model || {};
      const m = bayes.test_metrics || {};
      const train = result.training || {};
      const predictions = bayes.predictions || [];
      const shapAvailable = true; // Existing /api/shap endpoint and saved SHAP artifact are present.
