        ["Bayesian risk experiment", `Variational Bayesian neural network · ${esc(train.posterior_samples_at_test ?? "—")} posterior samples · ${esc(train.test_edges ?? m.n ?? "—")} test edges · ${esc(train.epochs_run ?? "—")} training epochs.`],
        ["BNN held-out metrics", `Accuracy ${Number.isFinite(m.accuracy) ? (m.accuracy * 100).toFixed(1) + "%" : "—"} · Precision ${Number.isFinite(m.precision) ? m.precision.toFixed(3) : "—"} · Recall ${Number.isFinite(m.recall) ? m.recall.toFixed(3) : "—"} · F1 ${Number.isFinite(m.f1) ? m.f1.toFixed(3) : "—"} · Brier ${Number.isFinite(m.brier_score) ? m.brier_score.toFixed(4) : "—"} · MAE ${Number.isFinite(m.mae) ? m.mae.toFixed(4) : "—"}.`],
        ["BNN prediction output", `${predictions.length} held-out predictions with posterior uncertainty intervals and prototype LOW/MEDIUM/HIGH bands. These are attack-edge-label proxy scores, not validated post-remediation residual risk.`],
        ["Validation and Judge", "Pending · no controlled post-remediation validation result or Judge PASS/FAIL is claimed."],
        ["Limitations", "Small test set (n=12); uncertainty intervals and prototype bands are not calibrated for operational residual-risk decisions."]
      ];

      const existing = report.querySelector("#autoshield-integrated-report");
