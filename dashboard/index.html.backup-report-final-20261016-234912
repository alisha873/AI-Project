    if (!report || report.dataset.consolidated === 'yes') return;

    const heading = report.querySelector('.flow-head');
    const rows = [...report.querySelectorAll(':scope > .report-row')];
    const existing = report.querySelector('#autoshield-integrated-report');

    // Create one shared card for both the summary and evaluation information.
    const card = document.createElement('div');
    card.id = 'autoshield-integrated-report';
    card.className = 'result';
    card.style.marginTop = '18px';
    card.style.padding = '18px';

    const title = document.createElement('h3');
    title.textContent = 'Incident summary, evaluation and module status';
    card.appendChild(title);

    rows.forEach(row => card.appendChild(row));

    if (existing) {
      // Move its contents into the same card rather than keeping a second box.
      const children = [...existing.children];
      children.forEach(child => card.appendChild(child));
      existing.remove();
    }

    if (rows.length || existing) {
      if (heading) heading.insertAdjacentElement('afterend', card);
      else report.appendChild(card);
    }
    report.dataset.consolidated = 'yes';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', consolidateReport, {once:true});
  } else {
    consolidateReport();
  }
})();
</script>

</body></html>