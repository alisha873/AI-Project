        $("stageBody").insertAdjacentHTML("beforeend",
          `<div class="notice">Could not load RAG artifact: ${esc(error.message)}. Check the API and incident artifact path.</div>`);
      }
    }

    const reportVisible = $("reportView") && !$("reportView").classList.contains("hidden");
    const stageTitle = ($("stageTitle")?.textContent || "").toLowerCase();
    if (reportVisible || stageTitle.includes("risk") || stageTitle.includes("report")) {
      await updateReport();
    }
  }

  const title = $("stageTitle");
  const body = $("stageBody");
  if (title) new MutationObserver(sync).observe(title, {childList:true,subtree:true,characterData:true});
  if (body) new MutationObserver(sync).observe(body, {childList:true,subtree:true});
  $("nav-report")?.addEventListener("click", () => setTimeout(updateReport, 0));
  setTimeout(sync, 250);
})();
</script>


<script>
/* AUTOSHIELD_ALL_STAGE_NAVIGATION_FIX */
(() => {
  const rail = document.getElementById("rail");
  if (!rail) return;

  // The existing guided renderer owns the stage content and updates the
  // current stage, visited set, Continue button, and other UI elements.
  rail.addEventListener("click", event => {
    const item = event.target.closest("[data-step]");
    if (!item) return;

    const index = Number(item.dataset.step);
    if (!Number.isInteger(index) || index < 0 || index > 7) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    document.getElementById("flowView").classList.remove("hidden");
    document.getElementById("reportView").classList.add("hidden");
    document.getElementById("nav-flow").classList.add("active");
    document.getElementById("nav-report").classList.remove("active");

    if (typeof render === "function") {
      render(index);
    } else {
      console.error("Stage renderer is unavailable.");
    }
  }, true);

  // Wrap drawRail so the progress line and numbered stages consistently
  // reflect progress up to the current stage, including when jumping ahead.
  if (typeof drawRail === "function" && !drawRail.__progressWrapped) {
    const originalDrawRail = drawRail;
    const wrappedDrawRail = function () {
      originalDrawRail();

      const title = document.getElementById("stageNum")?.textContent || "";
      const match = title.match(/STAGE\s+(\d+)/i);
      const current = match ? Number(match[1]) - 1 : -1;

      rail.querySelectorAll("[data-step]").forEach(el => {
        const index = Number(el.dataset.step);
        const completed = current >= 0 && index < current;
        el.classList.toggle("done", completed);
        el.classList.toggle("active", index === current);
        const bubble = el.querySelector(".bubble");
        if (bubble) {
          bubble.textContent = completed
            ? "✓"
            : String(index + 1).padStart(2, "0");
        }
      });
    };
    wrappedDrawRail.__progressWrapped = true;
    drawRail = wrappedDrawRail;
  }
})();
</script>


