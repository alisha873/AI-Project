<script>
(() => {
  const API = "http://127.0.0.1:8001";
  const btn = document.getElementById("nextBtn");
  const back = document.getElementById("backBtn");
  const stageBody = document.getElementById("stageBody");
  const resultTitle = document.getElementById("resultTitle");
  const resultBody = document.getElementById("resultBody");
  const progress = document.getElementById("progressLabel");
  const stageNum = document.getElementById("stageNum");
  const title = document.getElementById("stageTitle");
  const desc = document.getElementById("stageDesc");
  const stepHint = document.getElementById("stepHint");
  const rail = document.getElementById("rail");
  const labels = ["Evidence", "Graph + GNN", "Reconstruction", "Dual-Vector RAG", "Remediate", "Validate", "Judge + SHAP", "Risk + Report"];
  let runId = null, source = null, running = false, currentStep = -1, liveFinished = false;
  let logs = [], states = {}, parsed = {}, artifacts = {}, streamError = null;

  function esc(s) { return String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
  function panel() {
    let p = document.getElementById("liveActivity");
    if (!p) {
      p = document.createElement("section");
      p.id = "liveActivity"; p.className = "result"; p.style.marginTop = "16px";
      p.innerHTML = '<h3>Live pipeline activity <span id="liveStatus" class="status">Connecting…</span></h3><div id="liveSummary" style="color:var(--muted);margin:8px 0">Waiting for backend events.</div><pre id="liveLog" style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:240px;overflow:auto;background:#f7f9fa;border:1px solid var(--line);border-radius:10px;padding:12px;font:11px/1.5 ui-monospace,monospace"></pre>';
      stageBody.appendChild(p);
    }
    return p;
  }
  function log(s) {
    logs.push(s); if (logs.length > 220) logs = logs.slice(-220);
    const p=panel(), pre=p.querySelector("#liveLog"); pre.textContent=logs.join("\n"); pre.scrollTop=pre.scrollHeight;
  }
  function status(s,kind="") {
    const p=panel(); const el=p.querySelector("#liveStatus");
    el.textContent=s; el.className="status "+kind; p.querySelector("#liveSummary").textContent=s;
  }
  function renderRail() {
    rail.innerHTML = labels.map((name,i) => {
      const state=states[i] || (i<3 && liveFinished ? "available" : "pending");
      const cls=(i===currentStep?"active ":"")+(state==="completed"||state==="available"?"done":"");
      const symbol=state==="completed"?"✓":String(i+1).padStart(2,"0");
      return `<div class="rail-step ${cls}" data-step="${i}" title="${esc(state)}"><div class="bubble">${symbol}</div><b>${esc(name)}</b></div>`;
    }).join("");
    rail.querySelectorAll("[data-step]").forEach(el => el.addEventListener("click", () => {
      const i=Number(el.dataset.step);
      if (i<=2 && liveFinished) showStep(i);
      else if (i===currentStep) showStep(i);
    }));
    progress.textContent = running ? "Pipeline running" : liveFinished ? "Results ready · guided view" : "Ready to start";
  }
  function metric(label,value,foot="") { return `<div class="metric"><span>${esc(label)}</span><b>${esc(value)}</b><small>${esc(foot)}</small></div>`; }
  function showStart() {
    currentStep=-1; document.getElementById("mainTitle").textContent="Move through the incident, one stage at a time.";
    document.getElementById("mainSub").textContent="Run the real pipeline once, then review each result at your own pace.";
    stageNum.textContent="READY · INC-001"; title.textContent="Start investigation";
    desc.textContent="Start the backend run. Watch live script output, then step through the retained results.";
    stageBody.innerHTML=`<div class="metrics">${metric("Incident","INC-001","Controlled scenario")}${metric("Mode","Live run","Then guided review")}${metric("Stages","3 executable","Remaining modules pending")}</div><div class="notice">The backend runs once. After it finishes, use Continue to review Evidence, Graph + GNN, and Reconstruction without rerunning scripts.</div>`;
    resultTitle.textContent="What happens here"; resultBody.innerHTML="<p><strong>Start investigation</strong> launches the existing analysis and narrative scripts.</p><p>RAG retrieval results, saved SHAP explanations and Bayesian risk evaluation are available. Controlled validation and Judge decision remain pending.</p>";
    btn.disabled=running; btn.textContent=running?"Running pipeline…":"Start investigation →"; back.disabled=true; stepHint.textContent="Ready"; renderRail();
  }
  function eventTable(recon) {
    const events = Array.isArray(recon?.timeline) ? recon.timeline : [];
    const rows = events.map(e => `<tr data-search="${esc([e.timestamp,e.event_id,e.source,e.event_type,e.action,e.source_entity,e.destination_entity,e.interpretation_status].join(" ").toLowerCase())}">
      <td>${esc((e.timestamp||"").replace("T"," ").replace("Z"," UTC"))}</td><td><code>${esc(e.event_id||"—")}</code></td>
      <td>${esc(e.source||"—")}</td><td>${esc(e.event_type||"—")}</td><td>${esc(e.action||"—")}</td>
      <td>${esc(e.interpretation_status||"—")}</td></tr>`).join("");
    return `<div class="result" style="margin-top:14px"><h3>Normalized timeline events <span class="status">${events.length} loaded from reconstruction JSON</span></h3>
      <input id="eventSearch" aria-label="Search timeline events" placeholder="Search event ID, source, type, action…" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;margin:4px 0 10px;font:inherit">
      <div style="overflow:auto;max-height:390px"><table id="eventTable" style="width:100%;border-collapse:collapse;font-size:11px;white-space:nowrap"><thead><tr>${["Timestamp","Event ID","Source","Type","Action","Interpretation"].map(x=>`<th style="position:sticky;top:0;background:#edf3f2;text-align:left;padding:9px;border-bottom:1px solid var(--line)">${x}</th>`).join("")}</tr></thead><tbody>${rows||'<tr><td colspan="6">No timeline events available in the artifact.</td></tr>'}</tbody></table></div>
      <p id="eventCount">${events.length} events shown. Source details reflect the stored reconstruction artifact.</p></div>`;
  }
  function wireEventSearch() {
    const input=document.getElementById("eventSearch"), table=document.getElementById("eventTable");
    if(!input||!table)return;
    input.addEventListener("input",()=>{const q=input.value.toLowerCase().trim();let n=0;
      table.querySelectorAll("tbody tr").forEach(tr=>{const match=(tr.dataset.search||"").includes(q);tr.style.display=match?"":"none";if(match)n++;});
      const count=document.getElementById("eventCount");if(count)count.textContent=`${n} of ${table.querySelectorAll("tbody tr").length} events shown.`;
    });
  }
  function incidentTimeline(recon, root) {
    const timeline=Array.isArray(recon?.timeline)?recon.timeline:[];
    const ids=new Set(["application-4","nginx-19"]);
    const highlighted=timeline.filter(e=>ids.has(e.event_id));
    const finding=root?.findings?.[0]||{};
    return `<div class="result" style="margin-bottom:12px"><h3>Investigation timeline</h3>
      ${highlighted.length?highlighted.map(e=>`<div class="log-row" style="margin:12px 0"><div class="log-icon">!</div><div><b>${esc(e.event_id)} · ${esc(e.source)} · ${esc(e.action)}</b><small>${esc(e.timestamp)} · ${esc(e.interpretation_status)} · request ID: ${esc(e.request_context?.request_id||"not available")}</small></div></div>`).join(""):'<p>Candidate request events were not found in the loaded timeline.</p>'}
      <p><strong>Interpretation:</strong> similar SQL-injection-shaped requests are candidates for correlation; no shared request ID proves they are the same request.</p>
      <hr style="border:0;border-top:1px solid var(--line);margin:12px 0">
      <h3>Root-cause assessment</h3><p><strong>Status:</strong> ${esc(finding.status||"unknown")}</p><p><strong>Hypothesis:</strong> ${esc(finding.vulnerability_type||"Not specified")}</p><p><strong>Confidence recorded by analysis:</strong> ${finding.confidence==null?"not supplied":esc(finding.confidence)}</p><p>${esc(finding.rationale||"No rationale in artifact.")}</p>
      <p><strong>Evidence still needed:</strong> ${Array.isArray(finding.evidence_needed_to_confirm)?finding.evidence_needed_to_confirm.map(esc).join(" · "):"Not specified"}</p></div>`;
  }
  function showStep(i) {
    currentStep=i;
    const shared=parsed.summary||{};
    document.getElementById("mainTitle").textContent="Incident INC-001";
    document.getElementById("mainSub").textContent=`Guided investigation · stage ${i+1} of 8 · run ${runId||"not started"}`;
    stageNum.textContent=`STAGE ${String(i+1).padStart(2,"0")} / INC-001`;
    back.disabled=false;
    stepHint.textContent=`Review stage ${i+1} of 3`;
    if(i===0){
      title.textContent="Collect & normalize evidence";
      desc.textContent="Results captured from the completed backend run. Event counts are taken from the script output.";
      const recon=artifacts["incident_reconstruction.json"];
      stageBody.innerHTML=`<div class="metrics">${metric("Normalized events",shared.normalized_events ?? recon?.evidence_summary?.normalized_event_count ?? "—","From analysis output")}${metric("Timeline events",shared.timeline_entries ?? recon?.timeline?.length ?? "—","Stored reconstruction")}${metric("Evidence-linked claims",shared.evidence_linked_claims ?? recon?.claims?.length ?? "—","From analysis output")}</div><div class="result"><h3>Evidence and provenance</h3><p>Rows below are loaded from the actual reconstruction JSON. Search by event ID, source, type, action, or interpretation status.</p><p><strong>Run:</strong> ${esc(runId||"—")}</p><p><strong>Sources present:</strong> ${esc([...new Set((recon?.timeline||[]).map(e=>e.source).filter(Boolean))].join(", ")||"Not available")}</p></div>${eventTable(recon)}`;
      wireEventSearch();
      resultTitle.textContent="Evidence stage status";
      resultBody.innerHTML=`<div class="log"><div class="log-row"><div class="log-icon">✓</div><div><b>Analysis script completed</b><small>Exit code 0 · output captured from live stream</small></div></div><div class="log-row"><div class="log-icon">i</div><div><b>Provenance caveat</b><small>Detailed evidence rows are not yet served by a dedicated API endpoint.</small></div></div></div>`;
    } else if(i===1){
      title.textContent="Build graph & score relationships";
      desc.textContent="Graph counts and evaluation metrics are documented project results. The current run confirms graph size; held-out GNN metrics are recorded evaluation results, not a newly run test.";
      stageBody.innerHTML=`<div class="metrics">${metric("Graph nodes",shared.graph_nodes ?? "—","Actual analysis output")}${metric("Graph edges",shared.graph_edges ?? "—","Actual analysis output")}${metric("Held-out F1","0.875","Recorded test · n=12")}</div><div class="result"><h3>Graph evidence and interpretation</h3><p>Graph relationships recorded in the reconstruction artifact: ${esc((artifacts["incident_reconstruction.json"]?.graph_relationships||[]).length||"not exposed")}. The visualization is a conceptual excerpt; it does not invent a complete path.</p><p>Graph construction output is confirmed by the run. The GNN metric is a previously recorded evaluation result and is not claimed to have been recomputed during this dashboard run.</p><p><strong>Limitation:</strong> candidate edge scoring does not prove a complete attack path.</p></div>`;
      resultTitle.textContent="Graph confidence";
      resultBody.innerHTML="<div class='log'><div class='log-row'><div class='log-icon'>✓</div><div><b>Graph assembled</b><small>Node and edge counts came from the script output.</small></div></div><div class='log-row'><div class='log-icon'>!</div><div><b>Path uncertainty remains</b><small>Database activity was not independently observed.</small></div></div></div>";
    } else {
      title.textContent="Reconstruct incident & infer root cause";
      desc.textContent="Review the reconstruction status and root-cause uncertainty produced by the existing analysis.";
      const recon=artifacts["incident_reconstruction.json"];
      const root=artifacts["root_cause_analysis.json"];
      const raw = (obj) => obj ? esc(JSON.stringify(obj,null,2)) : "Artifact not found at expected path.";
      stageBody.innerHTML=`<div class="metrics">${metric("Timeline entries",shared.timeline_entries ?? recon?.timeline?.length ?? "—","Actual analysis output")}${metric("Evidence-linked claims",shared.evidence_linked_claims ?? recon?.claims?.length ?? "—","Actual analysis output")}${metric("Root-cause status",root?.findings?.[0]?.status ?? shared.root_cause_status ?? "unknown","Must remain unconfirmed unless evidence changes")}</div>${incidentTimeline(recon,root)}<details class="result"><summary style="cursor:pointer;font-weight:650">Inspect raw reconstruction JSON</summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:300px;overflow:auto;font:11px/1.5 ui-monospace,monospace">${raw(recon)}</pre></details><details class="result" style="margin-top:12px"><summary style="cursor:pointer;font-weight:650">Inspect raw root-cause JSON</summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:300px;overflow:auto;font:11px/1.5 ui-monospace,monospace">${raw(root)}</pre></details>`;
      resultTitle.textContent="Hypothesis · not confirmed";
      resultBody.innerHTML="<div class='log'><div class='log-row'><div class='log-icon'>!</div><div><b>Root cause remains a hypothesis</b><small>HTTP 200 does not prove exploitation success.</small></div></div><div class='log-row'><div class='log-icon'>!</div><div><b>No exfiltration claim</b><small>Database access is not independently verified.</small></div></div></div>";
    }
    btn.textContent=i<2?"Continue to "+labels[i+1]+" →":"View pending stages →";
    btn.disabled=!liveFinished;
    renderRail(); window.scrollTo({top:0,behavior:"smooth"});
  }
  async function startRun() {
    if(running) return;
    running=true; liveFinished=false; logs=[]; parsed={summary:{}}; states={}; currentStep=-1;
    btn.disabled=true; btn.textContent="Starting pipeline…";
    showStart(); status("Creating run…");
    try {
      const res=await fetch(API+"/api/runs",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({incident_id:"incident_001"})});
      if(!res.ok) throw new Error(`Start failed (${res.status}): ${await res.text()}`);
      const run=await res.json(); runId=run.run_id; log(`Run ${runId} · incident ${run.incident_id}`);
      source=new EventSource(API+"/api/runs/"+encodeURIComponent(runId)+"/stream");
      source.onmessage=(msg)=>{
        let e; try{e=JSON.parse(msg.data)}catch{return}
        if(e.type==="run_started"){status("Running · "+e.incident_id);log("▶ Pipeline started");}
        else if(e.type==="stage_started"){states[e.stage]="running";status("Running · "+e.label);log("\n▶ "+e.label);}
        else if(e.type==="stage_log"){
          log("["+e.stage+"] "+e.message);
          const m=e.message.match(/"(normalized_events|graph_nodes|graph_edges|timeline_entries|evidence_linked_claims|root_cause_status|narrative_validation_passed)"\s*:\s*(.*?)(,)?$/);
          if(m){let v=m[2].trim().replace(/^"|"$/g,"");parsed.summary[m[1]]=v;if(["normalized_events","graph_nodes","graph_edges","timeline_entries","evidence_linked_claims"].includes(m[1]))parsed.summary[m[1]]=Number(v);}
        } else if(e.type==="stage_completed"){states[e.stage]="completed";status("Completed · "+e.stage);log("✓ "+e.stage+" completed");}
        else if(e.type==="stage_pending"){states[e.stage]="pending";log("… "+e.label+" — "+e.message);}
        else if(e.type==="stage_failed"){states[e.stage]="failed";status("Failed · "+e.stage,"warn");log("✕ "+e.message);}
        else if(e.type==="run_failed"){status("Run failed at "+e.stage,"warn");log("Pipeline stopped: "+e.message);finish(false);}
        else if(e.type==="run_finished"){log("Pipeline finished. Unconnected stages remain pending.");finish(true);}
      };
      source.onerror=()=>{if(running){log("Stream connection closed.");finish(false)}};
    }catch(err){log("ERROR: "+err.message);status("Could not start","warn");finish(false);}
  }
  function finish(ok){
    running=false; liveFinished=ok; if(source){source.close();source=null}
    if (ok) {
      fetch(API + "/api/incidents/incident_001/artifacts")
        .then(r => r.ok ? r.json() : Promise.reject(new Error("Artifact endpoint unavailable")))
        .then(data => { artifacts = data.artifacts || {}; log("Loaded available JSON artifacts: " + Object.keys(artifacts).join(", ")); })
        .catch(err => log("Artifact fetch note: " + err.message));
    }
    status(ok?"Run complete · results ready":"Run ended · inspect logs",ok?"":"warn");
    btn.disabled=!ok; btn.textContent=ok?"Review evidence →":"Retry investigation →";
    btn.onclick=ok?()=>showStep(0):startRun;
    back.disabled=false; renderRail();
  }
  btn.onclick=startRun;
  back.onclick=()=>{if(currentStep>0)showStep(currentStep-1);else showStart()};
  // Override the old demo-only navigation handler with explicit, user-paced result review.
  btn.onclick=startRun;
  const originalRenderRail = window.renderRail;
  fetch(API+"/api/health").then(r=>{if(!r.ok)throw new Error();return r.json()}).then(()=>{
    const badge=document.querySelector(".top .pill"); if(badge)badge.innerHTML='<i class="dot"></i> API CONNECTED · LIVE RUNS';
    const note=document.querySelector(".side-note"); if(note)note.innerHTML="<b>Live pipeline enabled</b><br><br>Evidence, narrative, RAG retrieval and remediation scripts run from the backend. SHAP and Bayesian risk results are available. Controlled validation and Judge decision remain pending.";
  }).catch(()=>{const badge=document.querySelector(".top .pill");if(badge)badge.innerHTML='<i class="dot"></i> API OFFLINE';});
  // Existing rail click behavior is intentionally replaced by renderRail's guarded clicks.
  window.renderRail=renderRail;
  // Wrap the initial page's old handlers by assigning after their setup.
  document.getElementById("nextBtn").onclick=startRun;
  document.getElementById("backBtn").onclick=()=>{if(currentStep>0)showStep(currentStep-1);else showStart()};
  showStart();
})();
</script>

<script>
/* AUTOSHIELD_SHAP_DASHBOARD_INTEGRATION */
(() => {
  const API = "http://127.0.0.1:8001";
  const titleEl = document.getElementById("stageTitle");
  const bodyEl = document.getElementById("stageBody");
  if (!titleEl || !bodyEl) return;

  let requestStarted = false;
  let lastRenderedTitle = "";

  const escapeHtml = value => String(value ?? "").replace(/[&<>"']/g, c => ({
    "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;"
  }[c]));

  function isShapStage() {
    const title = titleEl.textContent.toLowerCase();
    return title.includes("judge") || title.includes("shap");
  }

  function renderUnavailable(message) {
    const panel = document.getElementById("autoshield-shap-panel");
    if (panel) {
      panel.innerHTML =
        '<h3>SHAP model explanation</h3>' +
        '<span class="status pending">Unavailable</span>' +
        '<p>' + escapeHtml(message) + '</p>' +
        '<p>Generate an explanation with <code>python -m evaluation.run_gnn_shap</code>, then reload this stage.</p>';
    }
  }

  async function loadShap() {
    if (!isShapStage() || requestStarted) return;
    requestStarted = true;

    const card = document.createElement("section");
    card.className = "result";
    card.id = "autoshield-shap-panel";
    card.style.marginTop = "14px";
    card.innerHTML = "<h3>SHAP model explanation</h3><p>Loading saved explanation…</p>";
    bodyEl.appendChild(card);

    try {
      const response = await fetch(API + "/api/shap");
      if (!response.ok) {
        let message = "API returned HTTP " + response.status;
        try {
          const detail = await response.json();
          if (detail.detail) message = detail.detail;
        } catch (_) {}
        throw new Error(message);
      }

      const data = await response.json();
      if (!Array.isArray(data.contributions)) {
        throw new Error("SHAP response has an invalid contributions list.");
      }

      const edge = data.edge || {};
      const top = data.contributions.slice(0, 10);
      const score = Number(data.score);
      const baseline = Number(data.baseline);
      const reconstructionError = Math.abs(
        score - Number(data.reconstructed_score)
      );

      const rows = top.map(item => {
        const value = Number(item.contribution);
        const positive = value > 1e-10;
        const negative = value < -1e-10;
        const color = positive ? "var(--red)" :
                      negative ? "var(--teal)" : "var(--muted)";
        const direction = positive ? "Raises score" :
                          negative ? "Lowers score" : "No change";
        return `<tr>
          <td style="padding:8px 5px;overflow-wrap:anywhere">${escapeHtml(item.feature)}</td>
          <td style="padding:8px 5px;text-align:right;color:${color};font-variant-numeric:tabular-nums">${value.toFixed(4)}</td>
          <td style="padding:8px 5px;color:var(--muted)">${direction}</td>
        </tr>`;
      }).join("");

      card.innerHTML = `
        <h3>SHAP · GCN edge explanation</h3>
        <p><strong>Candidate edge:</strong>
          ${escapeHtml(edge.source)} → ${escapeHtml(edge.target)}
          (${escapeHtml(edge.type)})</p>
        <div class="metrics">
          <div class="metric"><span>Raw edge logit</span>
            <b>${Number.isFinite(score) ? score.toFixed(3) : "—"}</b>
            <small>Not a probability</small></div>
          <div class="metric"><span>SHAP baseline</span>
            <b>${Number.isFinite(baseline) ? baseline.toFixed(3) : "—"}</b>
            <small>Reference output</small></div>
          <div class="metric"><span>Reconstruction error</span>
            <b>${Number.isFinite(reconstructionError) ? reconstructionError.toExponential(2) : "—"}</b>
            <small>Baseline + contributions</small></div>
        </div>
        <h3>Top feature contributions</h3>
