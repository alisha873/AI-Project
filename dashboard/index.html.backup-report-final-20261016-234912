<script>
/* AUTOSHIELD_REAL_RAG_AND_REPORT_INTEGRATION */
(() => {
  const API = "http://127.0.0.1:8001";
  const $ = id => document.getElementById(id);
  const esc = value => String(value ?? "").replace(/[&<>"']/g, c =>
    ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])
  );
  let lastRagRender = null;

  async function loadArtifacts() {
    const response = await fetch(API + "/api/incidents/incident_001/artifacts");
