document.getElementById('nextBtn').onclick=()=>{if(current<0)render(0);else if(current<stages.length-1)render(current+1);else showReport()};document.getElementById('backBtn').onclick=()=>{if(current>0)render(current-1);else{current=-1;visited.clear();document.getElementById('mainTitle').textContent='Move through the incident, one stage at a time.';document.getElementById('mainSub').textContent='Review the recorded evidence, graph analysis, RAG retrieval, advisory remediation, SHAP explanation and Bayesian risk experiment. Controlled validation and Judge decision remain pending.';document.getElementById('stageNum').textContent='READY · INC-001';document.getElementById('stageTitle').textContent='Start investigation';document.getElementById('stageDesc').textContent='Follow controlled SQL injection scenario INC-001 through the AutoShield AI pipeline. Each step reveals the output produced at that stage.';document.getElementById('stageBody').innerHTML='<div class="metrics"><div class="metric"><span>Incident</span><b>INC-001</b><small>Controlled scenario</small></div><div class="metric"><span>Input</span><b>Evidence</b><small>Logs and artifacts</small></div><div class="metric"><span>Mode</span><b>Guided</b><small>Presentation walkthrough</small></div></div><div class="notice">The backend run has completed. Use the phase navigation to review the recorded outputs.</div>';document.getElementById('resultTitle').textContent='What happens here';document.getElementById('resultBody').innerHTML='<p><strong>Start</strong> to begin the guided flow.</p><p>At each stage, the result panel explains what is available and what remains unverified.</p>';document.getElementById('progressLabel').textContent='Ready to start';document.getElementById('stepHint').textContent='Stage 0 of 8';document.getElementById('backBtn').disabled=true;document.getElementById('nextBtn').textContent='Start investigation →';drawRail()}};
function showReport(){document.getElementById('flowView').classList.add('hidden');document.getElementById('reportView').classList.remove('hidden');document.getElementById('nav-report').classList.add('active');document.getElementById('nav-flow').classList.remove('active');document.getElementById('mainTitle').textContent='Incident report preview';document.getElementById('mainSub').textContent='Documented results, uncertainty, and module integration status.';window.scrollTo({top:0,behavior:'smooth'})}document.getElementById('nav-flow').onclick=()=>{document.getElementById('flowView').classList.remove('hidden');document.getElementById('reportView').classList.add('hidden');document.getElementById('nav-flow').classList.add('active');document.getElementById('nav-report').classList.remove('active');if(current>=0)render(current)};document.getElementById('nav-report').onclick=showReport;drawRail();
