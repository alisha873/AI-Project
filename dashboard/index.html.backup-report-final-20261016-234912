<script>
/* AUTOSHIELD_BNN_RISK_PANEL */
(function () {
  const titleEl = document.getElementById("stageTitle");
  const bodyEl = document.getElementById("stageBody");
  if (!titleEl || !bodyEl) return;

  const apiBase = "http://127.0.0.1:8001";
  let requestToken = 0;

  function isRiskStage() {
    const title = (titleEl.textContent || "").toLowerCase();
    return title.includes("risk") || title.includes("report");
  }

  function addPanel() {
    if (!isRiskStage()) {
      const old = document.getElementById("autoshield-bnn-panel");
      if (old) old.remove();
      return;
    }

    if (document.getElementById("autoshield-bnn-panel")) return;

    const panel = document.createElement("section");
    panel.id = "autoshield-bnn-panel";
    panel.className = "result";
    panel.style.marginTop = "16px";
    panel.innerHTML =
      "<h3>Bayesian Neural Network · Phase 16</h3>" +
      "<p>Loading saved BNN experiment results…</p>";
    bodyEl.appendChild(panel);

    const token = ++requestToken;
    fetch(apiBase + "/api/bnn-risk")
      .then(function (response) {
        if (!response.ok) throw new Error("API returned HTTP " + response.status);
        return response.json();
      })
      .then(function (payload) {
        if (token !== requestToken || !panel.isConnected) return;

        if (!payload.available || !payload.result) {
          panel.innerHTML =
            "<h3>Bayesian Neural Network · Phase 16</h3>" +
            "<p>Saved results are unavailable. Run " +
            "<code>python -m evaluation.run_bnn_risk</code> first.</p>";
          return;
        }

        const r = payload.result;
        const b = r.bayesian_model || {};
        const m = b.test_metrics || {};
        const predictions = b.predictions || [];
        const training = r.training || {};

        const esc = function (v) {
          return String(v == null ? "—" : v).replace(/[&<>"']/g, function (c) {
            return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
          });
        };
        const pct = function (v) {
          return Number.isFinite(Number(v)) ? (100 * Number(v)).toFixed(1) + "%" : "—";
        };

        let rows = predictions.map(function (x) {
          const interval = x.bayesian_90_percent_interval || [];
          return "<tr>" +
            "<td>" + esc(x.scenario_id) + "</td>" +
            "<td>" + pct(x.bayesian_mean_probability) + "</td>" +
            "<td>" + esc(interval.length === 2 ?
              pct(interval[0]) + "–" + pct(interval[1]) : "—") + "</td>" +
            "<td>" + esc(x.proxy_risk_band) + "</td>" +
            "</tr>";
        }).join("");

        panel.innerHTML =
          "<h3>Bayesian Neural Network · Phase 16</h3>" +
          '<div class="metrics">' +
            '<div class="metric"><span>Mean test accuracy</span><b>' + pct(m.accuracy) +
              '</b><small>Held-out labelled edges</small></div>' +
            '<div class="metric"><span>Brier score</span><b>' +
              esc(Number.isFinite(Number(m.brier_score)) ? Number(m.brier_score).toFixed(4) : "—") +
              '</b><small>Lower is better</small></div>' +
            '<div class="metric"><span>Posterior samples</span><b>' +
              esc(training.posterior_samples_at_test) +
              '</b><small>Weight samples per prediction</small></div>' +
          '</div>' +
          '<p><strong>Method:</strong> ' + esc(r.method) + '</p>' +
          '<p><strong>Test edges:</strong> ' + esc(training.test_edges) +
          ' · <strong>Training epochs:</strong> ' + esc(training.epochs_run) + '</p>' +
          '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px">' +
            '<thead><tr><th style="text-align:left;padding:8px">Scenario</th>' +
            '<th style="text-align:left;padding:8px">Mean score</th>' +
            '<th style="text-align:left;padding:8px">90% interval</th>' +
            '<th style="text-align:left;padding:8px">Proxy band</th></tr></thead>' +
            '<tbody>' + rows + '</tbody></table></div>' +
          '<div class="notice"><strong>Prototype only:</strong> scores estimate positive attack-edge-label likelihood, ' +
          'not validated post-remediation residual risk. Judge status remains pending; ' +
          'uncertainty intervals have not been established as calibrated.</div>';
      })
      .catch(function (error) {
        if (token !== requestToken || !panel.isConnected) return;
        panel.innerHTML =
          "<h3>Bayesian Neural Network · Phase 16</h3>" +
          "<p>Could not load saved results: " + String(error.message || error) +
          ". Check that the API is running on port 8001.</p>";
      });
  }

  const observer = new MutationObserver(addPanel);
  observer.observe(titleEl, {childList:true, subtree:true, characterData:true});
  observer.observe(bodyEl, {childList:true, subtree:true});
  addPanel();
})();
</script>


