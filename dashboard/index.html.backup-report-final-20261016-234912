    if (lastRenderedTitle !== titleEl.textContent) {
      lastRenderedTitle = titleEl.textContent;
      requestStarted = false;
    }
    loadShap();
  }

  new MutationObserver(syncStage).observe(titleEl, {
    childList: true, subtree: true, characterData: true
  });
  new MutationObserver(syncStage).observe(bodyEl, {
    childList: true, subtree: false
  });
  syncStage();
})();
</script>


