      section.innerHTML = "<h3>Completed implementation and evaluation</h3>" +
        rows.map(([label, value]) => `<div class="report-row"><span>${label}</span><b>${value}</b></div>`).join("");
      report.appendChild(section);
      report.dataset.realIntegration = "done";
    } catch (error) {
      console.error("AutoShield report integration:", error);
    }
  }

  async function sync() {
    const title = ($("stageTitle")?.textContent || "").toLowerCase();
    if (title.includes("dual-vector rag")) {
      if (lastRagRender === title + "|" + $("stageNum")?.textContent) return;
      lastRagRender = title + "|" + $("stageNum")?.textContent;
      try {
        $("resultTitle").textContent = "Live artifact-backed retrieval";
        $("resultBody").innerHTML = "<p>Loading the saved RAG report from the incident artifact API…</p>";
